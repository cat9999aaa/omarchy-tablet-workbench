[Unit]
Description=Verified Dell touchscreen three-finger observation
After=systemd-udev-settle.service
[Service]
ExecStart=/usr/bin/python /usr/local/lib/pcadmin-control-center/gesture_daemon.py __UID__
Restart=on-failure
RestartSec=3
RuntimeDirectory=pcadmin-gesture
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/run/pcadmin-gesture
CapabilityBoundingSet=
[Install]
WantedBy=multi-user.target
