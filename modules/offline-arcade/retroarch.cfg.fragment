# Settings fragment: merge reviewed keys into a backed-up user configuration.
# This is not a complete replacement config or an automatic installer.
menu_driver = "glui"
user_language = "12"
menu_mouse_enable = "true"
menu_pointer_enable = "true"
input_driver = "wayland"
input_joypad_driver = "sdl2"
input_autodetect_enable = "true"
input_overlay_enable = "false"
input_menu_toggle_gamepad_combo = "4"
input_menu_toggle = "f1"
input_pause_toggle = "p"
input_save_state = "f2"
input_load_state = "f4"
input_exit_emulator = "escape"
quit_press_twice = "true"
input_player1_select = "num5"
input_player1_start = "num1"
input_player1_up = "up"
input_player1_down = "down"
input_player1_left = "left"
input_player1_right = "right"
input_player1_b = "z"
input_player1_a = "x"
input_player1_y = "a"
input_player1_x = "s"
input_player1_l = "q"
input_player1_r = "w"
video_driver = "gl"
video_vsync = "true"
video_shader_enable = "false"
rewind_enable = "false"
run_ahead_enabled = "false"
savestate_auto_save = "true"
savestate_auto_load = "false"
savestate_auto_index = "true"
autosave_interval = "60"
desktop_menu_enable = "false"
input_desktop_menu_toggle = "nul"
ui_companion_enable = "false"
ui_companion_start_on_boot = "false"
network_cmd_enable = "false"
stdin_cmd_enable = "false"
core_info_cache_enable = "false"
menu_show_online_updater = "false"
assets_directory = "/usr/share/retroarch/assets"
libretro_directory = "/usr/lib/libretro"
libretro_info_path = "/usr/share/libretro/info"
joypad_autoconfig_dir = "/usr/share/libretro/autoconfig"
system_directory = "~/.local/share/retroarch/system"
playlist_directory = "~/.local/share/retroarch/playlists"
savefile_directory = "~/.local/share/retroarch/saves"
savestate_directory = "~/.local/share/retroarch/states"
screenshot_directory = "~/.local/share/retroarch/screenshots"
menu_font_path = "/usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc"
video_font_path = "/usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc"
